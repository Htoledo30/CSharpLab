<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Os testes do motor dos jogos desenham a janela (fora da tela). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpLab.Core\CSharpLab.Core.csproj" />
    <ProjectReference Include="..\..\src\CSharpLab.Game\CSharpLab.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF tira o System.IO dos usings automáticos. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>

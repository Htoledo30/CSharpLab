<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CSharpLab.ViewModels"
                    xmlns:ui="clr-namespace:CSharpLab.Ui">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Abas TERMINAL / PROBLEMAS -->
    <Style x:Key="PanelTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="4" Padding="9,0" Margin="0,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="9,0" Background="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProblemRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,3,12,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ProblemTemplate" DataType="{x:Type vm:ProblemItem}">
        <Button Style="{StaticResource ProblemRow}" ToolTip="{Binding Details}" ToolTipService.InitialShowDelay="600"
                AutomationProperties.Name="{Binding LevelLabel}"
                Command="{Binding DataContext.NavigateToProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}" Tag="{Binding Details}">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copiar mensagem" Command="{x:Static ui:UiCommands.CopyText}" CommandParameter="{Binding Display}" />
                    <MenuItem Header="Copiar detalhes (código e mensagem original)" Command="{x:Static ui:UiCommands.CopyText}"
                              CommandParameter="{Binding Details}" />
                </ContextMenu>
            </Button.ContextMenu>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Saiba mais" FontSize="12" Margin="12,0,4,0"
                        Padding="0" VerticalAlignment="Center" ToolTip="Explicação da Microsoft, em português, com exemplos"
                        Visibility="{Binding HasHelp, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.OpenProblemHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0"
                           Text="{StaticResource IconError}" Foreground="{StaticResource ErrorBrush}" />
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="False">
                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource IconWarning}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LevelLabel}" Value="Dica">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>

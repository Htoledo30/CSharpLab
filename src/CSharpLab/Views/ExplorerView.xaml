<UserControl x:Class="CSharpLab.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CSharpLab.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="Novo arquivo" Command="{Binding Explorer.NewFileCommand}" />
            <MenuItem Header="Nova pasta" Command="{Binding Explorer.NewFolderCommand}" />
            <MenuItem Header="Nova tela do jogo…" Command="{Binding NewScreenCommand}"
                      Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}" />
            <Separator />
            <MenuItem Header="Renomear" InputGestureText="F2" Command="{Binding Explorer.RenameCommand}" />
            <MenuItem Header="Excluir" InputGestureText="Del" Command="{Binding Explorer.DeleteCommand}" />
            <Separator />
            <MenuItem Header="Mostrar no Explorador do Windows" Command="{Binding Explorer.RevealCommand}" />
            <MenuItem Header="Atualizar" Command="{Binding Explorer.RefreshCommand}" />
        </ContextMenu>

        <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
            <Grid x:Name="Row" Height="22" ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#6E6E77"
                           Text="&#xE7C3;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="3,0,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="EditBox" Grid.Column="1" Margin="0,0,4,0" Padding="3,1" Height="21" Visibility="Collapsed"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                         ToolTip="{Binding EditError}" Tag="{Binding}"
                         Loaded="OnEditBoxLoaded" IsVisibleChanged="OnEditBoxVisibleChanged"
                         PreviewKeyDown="OnEditBoxKeyDown" LostKeyboardFocus="OnEditBoxLostFocus" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <!-- Coisas que o CSharp Lab cuida sozinho (motor do jogo, guias para IAs) ficam mais apagadas -->
                <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                    <Setter TargetName="IconText" Property="Text" Value="{StaticResource IconFolder}" />
                    <Setter TargetName="IconText" Property="FontSize" Value="13" />
                    <Setter TargetName="IconText" Property="Foreground" Value="#8C8F99" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="CSharp">
                    <Setter TargetName="IconText" Property="Text" Value="C#" />
                    <Setter TargetName="IconText" Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter TargetName="IconText" Property="FontSize" Value="9" />
                    <Setter TargetName="IconText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="IconText" Property="Foreground" Value="#9D86E9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Project">
                    <Setter TargetName="IconText" Property="Text" Value="&#xE713;" />
                    <Setter TargetName="IconText" Property="Foreground" Value="#5FB3A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Json">
                    <Setter TargetName="IconText" Property="Text" Value="{}{}" />
                    <Setter TargetName="IconText" Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter TargetName="IconText" Property="FontSize" Value="10" />
                    <Setter TargetName="IconText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="IconText" Property="Foreground" Value="#C9AE6A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="IconText" Property="Text" Value="&#xE8A5;" />
                    <Setter TargetName="IconText" Property="Foreground" Value="#8C8F99" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Cabeçalho: nome da pasta e ações -->
        <Grid DockPanel.Dock="Top" Height="36" Margin="12,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" TextTrimming="CharacterEllipsis"
                       Text="{Binding Explorer.FolderName, TargetNullValue='EXPLORADOR', FallbackValue='EXPLORADOR'}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding Explorer.HasFolder, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconNewFile}" ToolTip="Novo arquivo"
                        AutomationProperties.Name="Novo arquivo" Command="{Binding Explorer.NewFileCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconNewFolder}" ToolTip="Nova pasta"
                        AutomationProperties.Name="Nova pasta" Command="{Binding Explorer.NewFolderCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconRefresh}" ToolTip="Atualizar"
                        AutomationProperties.Name="Atualizar" Command="{Binding Explorer.RefreshCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8C5;" ToolTip="Recolher tudo"
                        AutomationProperties.Name="Recolher tudo" Command="{Binding Explorer.CollapseAllCommand}" />
            </StackPanel>
        </Grid>

        <Grid>
            <TreeView x:Name="Tree" ItemsSource="{Binding Explorer.Root.Children}" Padding="0,0,0,8"
                      AutomationProperties.Name="Arquivos e pastas"
                      SelectedItemChanged="OnSelectedItemChanged" PreviewMouseLeftButtonUp="OnTreeMouseUp"
                      PreviewMouseRightButtonDown="OnTreeRightButtonDown" KeyDown="OnTreeKeyDown"
                      ContextMenu="{StaticResource NodeMenu}"
                      Visibility="{Binding Explorer.HasFolder, Converter={StaticResource BoolToVis}}" />

            <!-- Sem pasta aberta -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Explorer.HasFolder, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Margin="16,8,16,12">
                    <TextBlock Text="Nenhuma pasta aberta." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="Novo projeto…" HorizontalAlignment="Left" Margin="-6,10,0,0"
                            ToolTip="Um programa de console ou um jogo com botões" Command="{Binding NewProjectCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Abrir pasta…" HorizontalAlignment="Left" Margin="-6,2,0,0"
                            Command="{Binding OpenFolderDialogCommand}" />
                    <Button x:Name="ExamplesButton" Style="{StaticResource LinkButton}" Content="Exemplos para estudar…" HorizontalAlignment="Left"
                            Margin="-6,2,0,0" ToolTip="Jogos e programas prontos, com explicações em português" Click="OnExamplesClick" />

                    <!-- Recentes: um clique abre de novo -->
                    <TextBlock Text="RECENTES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,22,0,6"
                               Visibility="{Binding RecentItems.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="-6,0,0,0" ToolTip="{Binding Path}"
                                        Command="{Binding DataContext.OpenRecentCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE8B7;" Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="0,1,8,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="CSharpLab.Views.FindReplaceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1,0,1,1"
            CornerRadius="0,0,7,7" Padding="6,6,6,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ToggleButton x:Name="ReplaceToggle" Grid.RowSpan="2" Style="{StaticResource IconToggle}" Width="20" Height="Auto"
                          Margin="0,0,4,0" VerticalAlignment="Stretch" FontFamily="{StaticResource IconFont}" FontSize="9"
                          Content="{StaticResource IconChevronRight}" ToolTip="Mostrar substituição (Ctrl+H)"
                          AutomationProperties.Name="Mostrar substituição" Checked="OnReplaceToggled" Unchecked="OnReplaceToggled" />

            <TextBox x:Name="FindBox" Grid.Column="1" Width="230" AutomationProperties.Name="Buscar"
                     TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
            <TextBlock Grid.Column="1" Text="Buscar" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource TextMuted}"
                       Visibility="{Binding Text.IsEmpty, ElementName=FindBox, Converter={StaticResource BoolToVis}}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                <ToggleButton x:Name="MatchCase" Style="{StaticResource IconToggle}" Content="Aa" FontWeight="SemiBold"
                              ToolTip="Diferenciar maiúsculas e minúsculas" AutomationProperties.Name="Diferenciar maiúsculas"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <TextBlock x:Name="CountText" MinWidth="64" Margin="6,0" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconChevronUp}" FontSize="10"
                        ToolTip="Anterior (Shift+Enter)" AutomationProperties.Name="Ocorrência anterior" Click="OnPrevious" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconChevronDown}" FontSize="10"
                        ToolTip="Próxima (Enter)" AutomationProperties.Name="Próxima ocorrência" Click="OnNext" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IconClose}" FontSize="10"
                        ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar busca" Click="OnClose" />
            </StackPanel>

            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Width="230" Margin="0,5,0,0" Visibility="Collapsed"
                     AutomationProperties.Name="Substituir por" PreviewKeyDown="OnReplaceKeyDown" />
            <TextBlock x:Name="ReplaceHint" Grid.Row="1" Grid.Column="1" Text="Substituir por" Margin="9,5,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="4,5,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource TextButton}" Content="Substituir" Click="OnReplace" ToolTip="Substituir a ocorrência atual" />
                <Button Style="{StaticResource TextButton}" Content="Substituir tudo" Click="OnReplaceAll" Margin="2,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CSharpLab.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesma versão do compilador incluído no SDK .NET 10.0.301 (Roslyn 5.6.0). -->
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpLab.Tests" />
    <InternalsVisibleTo Include="CSharpLab.App.Tests" />
    <EmbeddedResource Include="Updates\ApplyUpdate.ps1" />
    <!-- Projetos de exemplo: guardados dentro do programa, não compilados com ele. -->
    <Compile Remove="Examples\**" />
    <EmbeddedResource Include="Examples\**\*.cs" />
    <!-- Jogos com botões: programa inicial e guia do motor para IAs. -->
    <Compile Remove="GameKit\**" />
    <EmbeddedResource Include="GameKit\**" />
  </ItemGroup>

</Project>
